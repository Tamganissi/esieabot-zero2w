[Unit]
Description=ESIEAbot - pilotage depuis un téléphone ou un PC (page web, port 8080)
Documentation=file://__HOME__/esieabot/README.md
After=network-online.target
Wants=network-online.target
Conflicts=esieabot.service

[Service]
Type=simple
User=__USER__
Group=__USER__
SupplementaryGroups=gpio i2c
WorkingDirectory=__HOME__/esieabot
Environment=PYTHONUNBUFFERED=1
# Filet de sécurité AVANT et APRÈS : broches moteur forcées en sortie à 0, quoi qu'il arrive au programme
ExecStartPre=/usr/bin/pinctrl set 17,22,23,25 op dl
ExecStart=__HOME__/esieabot/venv/bin/python __HOME__/esieabot/src/web.py
ExecStopPost=/usr/bin/pinctrl set 17,22,23,25 op dl
KillSignal=SIGTERM
TimeoutStopSec=5
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
