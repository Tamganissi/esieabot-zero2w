[Unit]
Description=ESIEAbot - pilotage avec la manette sans fil ESIEA
Documentation=file://__HOME__/esieabot/README.md
After=multi-user.target
Conflicts=esieabot-web.service

[Service]
Type=simple
User=__USER__
Group=__USER__
SupplementaryGroups=gpio i2c input
WorkingDirectory=__HOME__/esieabot
Environment=PYTHONUNBUFFERED=1
# Filet de sécurité AVANT et APRÈS : broches moteur forcées en sortie à 0, quoi qu'il arrive au programme
ExecStartPre=/usr/bin/pinctrl set 17,22,23,25 op dl
ExecStart=__HOME__/esieabot/venv/bin/python __HOME__/esieabot/src/main.py
ExecStopPost=/usr/bin/pinctrl set 17,22,23,25 op dl
KillSignal=SIGTERM
TimeoutStopSec=5
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
